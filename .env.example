# Modelo de linguagem: "ollama" (gratuito, roda no seu computador) ou "claude" (API paga)
LLM_PROVIDER=ollama

# Ollama (https://ollama.com). Baixe o modelo antes com: ollama pull qwen2.5:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Só se usar LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sua-chave-aqui
# CLAUDE_MODEL=claude-haiku-4-5

# Opcionais
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DOCS_DIR=docs
DB_PATH=data/rag.db
TOP_K=4
MIN_SCORE=0.30
LLM_TIMEOUT=180
